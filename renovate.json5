// Renovate configuration for dryvist/nix-ai-server
//
// Two big jobs:
//   1. Keep nixpkgs / nixos-hardware / disko / sops-nix / nixos-anywhere
//      / nix-ld / uv2nix / pyproject-nix / build-system-pkgs current.
//   2. Auto-PR the nixpkgs branch bump from `nixos-25.11` to `nixos-26.05`
//      the moment the new channel branch ships.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "local>JacobPEvans/.github:renovate-presets"
  ],

  "baseBranches": ["main"],
  "timezone": "America/New_York",
  "labels": ["dependencies", "renovate"],
  "assignees": ["@JacobPEvans"],
  "reviewers": ["@JacobPEvans"],

  "nix": { "enabled": true },

  "packageRules": [
    {
      "description": "Critical NixOS infrastructure inputs - daily 7am",
      "matchDatasources": ["git-refs"],
      "matchPackageNames": [
        "NixOS/nixpkgs",
        "NixOS/nixos-hardware",
        "nix-community/disko",
        "nix-community/nixos-anywhere",
        "Mic92/sops-nix",
        "nix-community/nix-ld"
      ],
      "groupName": "nixos-core",
      "schedule": ["after 7am"],
      "minimumReleaseAge": "2 days"
    },
    {
      "description": "Python uv2nix toolchain",
      "matchDatasources": ["git-refs"],
      "matchPackageNames": [
        "pyproject-nix/uv2nix",
        "pyproject-nix/pyproject.nix",
        "pyproject-nix/build-system-pkgs"
      ],
      "groupName": "uv2nix",
      "schedule": ["after 7am on Monday"]
    },
    {
      "description": "GitHub Actions - weekly Monday 7am",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "schedule": ["after 7am on Monday"]
    },
    {
      "description": "nixpkgs branch bump 25.11 -> 26.05 (auto-PR when channel ships)",
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["NixOS/nixpkgs"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "nixos-channel-bump",
      "labels": ["dependencies", "renovate", "channel-bump"],
      "prHeader": "**Channel bump**: review `lib/checks.nix`, `flake.nix` URL, and the `system.stateVersion` assertion in `hosts/ai-server-a/default.nix` before merging."
    }
  ],

  "commitMessagePrefix": "chore(deps): ",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{{depName}}}",
  "commitMessageExtra": "to {{{newVersion}}}",
  "commitBody": "Co-Authored-By: Renovate Bot <bot@renovateapp.com>",

  "prConcurrentLimit": 3,
  "prCreation": "immediate",
  "prHourlyLimit": 1,

  "branchPrefix": "chore/renovate/",
  "branchConcurrentLimit": 5,

  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard (Renovate)",

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": true,
    "minimumReleaseAge": "3 days"
  },

  "platformCommit": true
}
