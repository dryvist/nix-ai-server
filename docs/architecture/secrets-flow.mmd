flowchart LR
  subgraph commit["committed in git"]
    sops["secrets/*.enc.yaml (sops-nix, age)"]
    sopsyaml[".sops.yaml (recipients)"]
    bws["Bitwarden vault (age key backup)"]
  end

  subgraph cluster["dryvist Proxmox cluster"]
    openbao["OpenBao LXC :8200\n(Vault-API compatible)"]
  end

  subgraph host["server A"]
    activation["sops-nix activation\n-> /run/secrets/*"]
    agent["bao agent (systemd timer)\n-> /run/openbao/*.env"]
    vllm_unit["vLLM unit\nEnvironmentFile=/run/openbao/vllm.env"]
    promtail_unit["promtail unit\nEnvironmentFile=/run/openbao/promtail.env"]
  end

  sops --> activation
  sopsyaml --> sops
  bws -. backup .- sops
  activation --> agent
  openbao --> agent
  agent --> vllm_unit & promtail_unit
